---
// src/components/SearchBox.astro
---
<div class="w-full font-mono">
  {/* Search Input Bar styled like a terminal prompt */}
  <div class="relative flex items-center">
    <span class="absolute left-4 text-monokai-red font-bold">$</span>
    <input 
      type="text" 
      id="search-input" 
      placeholder="grep -i 'search posts...' " 
      class="w-full bg-monokai-dark text-monokai-text placeholder-monokai-comment text-xs sm:text-sm pl-8 pr-4 py-3 rounded-lg border border-monokai-comment/30 focus:border-monokai-cyan focus:outline-none transition-colors"
      autocomplete="off"
    />
  </div>

  {/* Results Container */}
  <div id="search-results" class="mt-4 space-y-3 hidden">
    <div class="text-xs text-monokai-comment px-1" id="result-count"></div>
    <div id="results-list" class="space-y-3"></div>
  </div>
</div>

<script>
  // We run this client-side when the browser loads the page
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('search-results');
    const resultsList = document.getElementById('results-list');
    const resultCount = document.getElementById('result-count');

    let searchData: any[] = [];
    let dataLoaded = false;

    // Lazy load the search.json data only when the user interacts with the input
    async function loadSearchData() {
      if (dataLoaded) return;
      try {
        const response = await fetch('/search.json');
        searchData = await response.json();
        dataLoaded = true;
      } catch (error) {
        console.error('Failed to load search index:', error);
      }
    }

    searchInput?.addEventListener('focus', loadSearchData);
    searchInput?.addEventListener('input', async (e) => {
      await loadSearchData();
      
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      
      if (!query) {
        resultsContainer?.classList.add('hidden');
        return;
      }

      // Filter posts matching title, description, category, or tags
      const filtered = searchData.filter(post => {
        const matchTitle = post.title?.toLowerCase().includes(query);
        const matchDesc = post.description?.toLowerCase().includes(query);
        const matchCategory = post.category?.toLowerCase().includes(query);
        const matchTags = post.tags?.some((tag: string) => tag.toLowerCase().includes(query));
        return matchTitle || matchDesc || matchCategory || matchTags;
      });

      // Render results
      if (resultsList && resultCount && resultsContainer) {
        resultsContainer.classList.remove('hidden');
        resultCount.textContent = `→ Found ${filtered.length} matching entries for "${query}"`;
        
        if (filtered.length === 0) {
          resultsList.innerHTML = `<div class="p-4 rounded-lg bg-monokai-dark border border-monokai-comment/20 text-xs text-monokai-comment">No matching files found.</div>`;
          return;
        }

        resultsList.innerHTML = filtered.map(post => `
          <a href="${post.url}" class=" no-underline block p-4 rounded-lg bg-monokai-dark border border-monokai-comment/20 hover:border-monokai-green/50 transition-all group">
            <div class="flex items-center justify-between text-xs text-monokai-comment mb-1">
              <span class="text-monokai-purple">-rw-r--r--</span>
              <span class="text-monokai-yellow">${post.date || ''}</span>
            </div>
            <h4 class="text-sm font-bold text-monokai-text group-hover:text-monokai-green transition-colors">
              <span class="text-monokai-red">&gt;</span> ${post.title}
            </h4>
            ${post.description ? `<p class="text-xs text-monokai-text/70 mt-1 line-clamp-1">${post.description}</p>` : ''}
          </a>
        `).join('');
      }
    });
  });
</script>
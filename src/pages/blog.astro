---
// src/pages/blog.astro
import Layout from "../layouts/Layout.astro";

// Fetch all markdown/mdx files recursively from ./blog/
const postFiles = import.meta.glob("./blog/**/*.{md,mdx}", { eager: true });
const posts = Object.values(postFiles);

// Sort posts by date (newest first)
const sortedPosts = posts.sort((a: any, b: any) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  );
});
---

<Layout title="Posts — BareMetalNerd">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 flex-1 w-full min-w-0">
    {/* GNOME Terminal Window Wrapper */}
    {/* GNOME Terminal Window Wrapper */}
    <div
      class="mb-10 rounded-xl bg-monokai-dark border border-monokai-comment/30 overflow-hidden shadow-2xl font-mono min-w-0"
    >
      {/* Terminal Titlebar (Fedora / GNOME Style: Controls on the right) */}
      <div
        class="bg-monokai-surface/70 px-4 py-3 flex items-center justify-between border-b border-monokai-comment/20"
      >
        {/* Title on the left */}
        <span class="text-xs text-monokai-comment select-none truncate pr-2">
          bash — bare-metal-nerd@workstation:~
        </span>

        {/* Fedora / GNOME Window Buttons on the Right */}
        <div class="flex items-center gap-2 shrink-0">
          <span
            class="w-3 h-3 rounded-full bg-monokai-green inline-block shadow-sm"
          ></span>
          <span
            class="w-3 h-3 rounded-full bg-monokai-yellow inline-block shadow-sm"
          ></span>
          <span
            class="w-3 h-3 rounded-full bg-monokai-red inline-block shadow-sm"
          ></span>
        </div>
      </div>

      {/* Terminal Body with Commands */}
      <div
        class="p-4 sm:p-6 text-xs sm:text-sm space-y-3 overflow-x-auto min-w-0"
      >
        {/* Simulated Command 1: Count (with safe wrapping or scrolling) */}
        <div class="flex items-start sm:items-center gap-2 flex-wrap min-w-0">
          <span class="text-monokai-red font-bold shrink-0">$</span>
          <span class="text-monokai-cyan shrink-0">find</span>
          <span class="text-monokai-text break-all sm:break-normal"
            >./src/pages/blog -type f \( -name "*.md" \) | wc
            -l</span
          >
        </div>
        <div class="text-monokai-green pl-4">
          → {sortedPosts.length} posts indexed successfully.
        </div>

        {/* Simulated Command 2: List */}
        <div
          class="flex items-start sm:items-center gap-2 flex-wrap pt-2 min-w-0"
        >
          <span class="text-monokai-red font-bold shrink-0">$</span>
          <span class="text-monokai-cyan shrink-0">ls</span>
          <span class="text-monokai-text break-all sm:break-normal"
            >-la --sort=time ./blog/</span
          >
        </div>
      </div>
    </div>
    {/* Post List */}
    <div class="space-y-4">
      {
        sortedPosts.map((post: any) => (
          <article class="p-4 sm:p-6 rounded-lg bg-monokai-dark border border-monokai-comment/20 hover:border-monokai-green/50 transition-all group min-w-0">
            <a href={post.url} class="no-underline">
              {/* File metadata row */}
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-monokai-comment mb-2">
                <div class="flex items-center gap-2">
                  <span class="text-monokai-purple">-rw-r--r--</span>
                  {post.frontmatter.date && (
                    <span class="text-monokai-yellow">
                      {post.frontmatter.date}
                    </span>
                  )}
                </div>
                {post.frontmatter.category && (
                  <span class="px-2 py-0.5 rounded bg-monokai-surface text-monokai-orange font-mono">
                    [{post.frontmatter.category}]
                  </span>
                )}
              </div>

              {/* Post Title */}
              <h2 class="text-base sm:text-lg font-bold font-mono text-monokai-text group-hover:text-monokai-green transition-colors break-words">
                <span class="text-monokai-red mr-1.5">&gt;</span>
                {post.frontmatter.title}
              </h2>

              {/* Description */}
              {post.frontmatter.description && (
                <p class="text-monokai-text/70 mt-2 text-xs sm:text-sm font-sans line-clamp-2">
                  {post.frontmatter.description}
                </p>
              )}

              {/* Tags section */}
              {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
                <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-monokai-comment/10">
                  <span class="text-[10px] font-mono text-monokai-comment mr-1">
                    tags:
                  </span>
                  {post.frontmatter.tags.map((tag: string) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-monokai-surface text-monokai-cyan border border-monokai-comment/20">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))
      }

      {
        sortedPosts.length === 0 && (
          <div class="text-center py-12 text-monokai-comment font-mono">
            $ ls: ./blog/: No posts found or directory empty.
          </div>
        )
      }
    </div>
  </main>
</Layout>

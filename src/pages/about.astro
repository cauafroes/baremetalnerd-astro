---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home — BareMetalNerd">
  <main class="max-w-4xl mx-auto px-6 py-10 flex-1 w-full">
    <section class="space-y-4">
      <h1 class="text-4xl font-extrabold tracking-tight font-mono text-monokai-text">
        Engineering notes & system ramblings.
      </h1>
      <p class="text-monokai-comment text-lg max-w-2xl font-sans">
        Exploring low-level systems, security engineering, and web development. Built with Astro and Tailwind.
      </p>
    </section>

    <!-- Example post card list -->
    <section class="mt-16 space-y-6">
      <h2 class="text-xl font-mono text-monokai-cyan border-b border-monokai-comment/30 pb-2">
        // recent_posts
      </h2>

      <article class="p-6 rounded-lg bg-monokai-dark border border-monokai-comment/20 hover:border-monokai-comment/60 transition-all group">
        <div class="flex items-center gap-4 text-xs font-mono text-monokai-comment mb-2">
          <span>2026-10-14</span>
          <span>•</span>
          <span class="text-monokai-orange">kernel</span>
        </div>
        <h3 class="text-lg font-bold font-mono text-monokai-text group-hover:text-monokai-green transition-colors">
          <a href="#">Customizing Linux Window Managers & Status Bars</a>
        </h3>
        <p class="text-monokai-text/70 mt-2 text-sm">
          A deep dive into configuring lightweight window managers and tuning scripts for minimal overhead.
        </p>
      </article>
    </section>
  </main>
</Layout>